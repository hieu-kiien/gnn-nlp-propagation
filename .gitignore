# Python cache, bytecode & test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Virtual environments & IDE/OS files
.venv/
venv/
env/
.vscode/
.idea/
Thumbs.db
.DS_Store

# Datasets, checkpoints, outputs & run logs (keep .gitkeep placeholders)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
checkpoints/
outputs/
logs/
.ipynb_checkpoints/
wandb/

# Track clean non-binary experimental artifacts in results/; keep binaries/temp/secrets ignored
results/*
!results/*.json
!results/*.md
!results/*.tex
!results/figures/
results/figures/*
!results/figures/*/
results/figures/*/*
!results/figures/*/*.svg
!results/figures/*/*.pdf

# Secrets, weights, datasets, archives & temp JSONs (placed AFTER !results/* so last-match wins)
.env
.env.*
*.secret
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.parquet
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.7z
runner_summary_*.json
results/runner_summary_*.json
*_machine_key.csv
*.tmp.json
*.jsonl

# Temporary / smoke outputs (commit only verified non-binary tables/JSON)
results/*smoke*
results/*draft*
results/*debug*
paper/*smoke*
paper/*draft*
paper/*debug*
archive/docs_v1/paper/*smoke*
archive/docs_v1/paper/*draft*
archive/docs_v1/paper/*debug*

# Backup, temp & LaTeX build artifacts
*.bak
*.tmp
*.part
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
paper/*.log
paper/*.out
paper/*.toc
archive/docs_v1/paper/*.log
archive/docs_v1/paper/*.out
archive/docs_v1/paper/*.toc

# Generated Word reports
reports/*.docx
archive/docs_v1/reports/*.docx
